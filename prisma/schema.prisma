generator client {
  provider = "prisma-client-js"
}

// SQLite for local development. To use PostgreSQL, change provider to "postgresql"
// and point DATABASE_URL at your database.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
